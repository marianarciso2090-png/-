# Never commit live credentials. Copy this file to .env on the deployment host.
POSTGRES_DB=stock_research
POSTGRES_USER=stock_research
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://stock_research:change-me-to-a-long-random-password@postgres:5432/stock_research
REDIS_URL=redis://redis:6379/0

# Required in production: use the same high-entropy secret for API and worker.
SESSION_SECRET=change-me-to-a-different-long-random-secret

# Users enter both provider keys in the web page; no host provider keys are needed.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_RESEARCH_MODEL=deepseek-v4-pro
DEEPSEEK_UTILITY_MODEL=deepseek-flash

# iFinD access is conservatively rate-limited unless the account allowance is known.
# Keep direct access by default because the MCP endpoint uses port 8643. Set true only
# when the deployment network requires a compatible HTTP(S) proxy.
IFIND_USE_ENV_PROXY=false
IFIND_MAX_REQUESTS_PER_SECOND=2
IFIND_CACHE_TTL_SECONDS=3600
REPORT_LANGUAGE=zh-CN
APP_ENV=production
